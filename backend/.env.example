# ============================================================
# SmartCourt Configuration: Real Email Sending (Gmail SMTP)
# ============================================================
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกข้อมูลจริง
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=SmartCourt ตึก 40 <your_email@gmail.com>
